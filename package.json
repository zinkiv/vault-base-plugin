{
	"name": "vault-base-plugin",
	"version": "0.2.7",
	"private": true,
	"description": "Bidirectional WebDAV sync for Obsidian",
	"keywords": [
		"obsidian",
		"sync",
		"webdav"
	],
	"license": "AGPL-3.0",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "cross-env MODE=dev tsdown --watch",
		"inspect": "cross-env MODE=inspect tsdown",
		"build": "tsdown",
		"ver": "node scripts/version-bump.mjs",
		"lint": "oxlint --fix && oxfmt",
		"check": "tsc && oxlint && oxfmt --check",
		"notes": "node scripts/release-notes.mjs",
		"test": "bun --preload=./test/mocks --isolate test",
		"package": "npm run build"
	},
	"devDependencies": {
		"@noble/ciphers": "^2.4.0",
		"@tsdown/css": "^0.23.0",
		"@types/bun": "^1.4.2",
		"@types/glob-to-regexp": "^0.4.4",
		"@unocss/postcss": "66.10.5",
		"@vitejs/devtools": "^0.7.6",
		"bun": "^1.4.2",
		"cross-env": "^10.0.0",
		"glob-to-regexp": "^0.4.1",
		"hash-wasm": "^4.12.0",
		"localspace": "^3.0.0",
		"node-diff3": "^3.2.1",
		"obsidian": "^1.13.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"postcss-merge-rules": "^9.0.5",
		"solid-js": "^1.9.15",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"unocss": "66.10.5",
		"unplugin-solid": "^3.0.0",
		"webdav": "^5.11.0"
	}
}
